{
  "name": "omp-agent",
  "productName": "OMP Agent",
  "version": "1.0.0",
  "description": "Antigravity & Codex-inspired Mac App UI for oh-my-pi Coding Agent",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --dir",
    "build:renderer": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "start": "vite",
    "test": "npm run test:preload && npm run test:framer && npm run test:bridge && npm run test:slash-commands && npm run test:tool-events && npm run test:extension-ui && npm run test:notifications && npm run test:observability && npm run test:session-control && npm run test:engine-control && npm run test:composer-attach && npm run test:composer-image-attachment && npm run test:markdown && npm run test:handshake && npm run test:stream && npm run test:model-state && npm run test:sessions && npm run test:subagent-hub && npm run test:renderer-chat && npm run test:renderer-tool-diff && npm run test:renderer-ui-request && npm run test:renderer-sessions && npm run test:tool-events-live && npm run test:extension-ui-live && npm run test:sessions-live && npm run test:settings && npm run test:provider-config && npm run test:roles-config && npm run test:modal-ux && npm run test:auth-login && npm run test:observability-live && npm run test:rpc-parity-live && npm run test:steering && npm run test:todos-panel && npm run test:subagent-transcript",
    "test:subagent-transcript": "node --experimental-strip-types scripts/verify-subagent-transcript.mjs",
    "test:todos-panel": "node --experimental-strip-types scripts/verify-todos-panel.mjs",
    "test:steering": "node --experimental-strip-types scripts/verify-steering.mjs",
    "test:rpc-parity-live": "node --experimental-strip-types scripts/verify-rpc-parity-live.mjs",
    "test:composer-image-attachment": "node --experimental-strip-types scripts/verify-composer-image-attachment.mjs",
    "test:observability-live": "node --experimental-strip-types scripts/verify-observability-live.mjs",
    "test:auth-login": "node --experimental-strip-types scripts/verify-auth-login.mjs",
    "test:modal-ux": "node --experimental-strip-types scripts/verify-modal-ux.mjs",
    "test:provider-config": "node --experimental-strip-types scripts/verify-provider-config.mjs",
    "test:roles-config": "node --experimental-strip-types scripts/verify-roles-config.mjs",
    "test:settings": "node --experimental-strip-types scripts/verify-settings.mjs",
    "test:slash-commands": "node --experimental-strip-types scripts/verify-slash-commands.mjs",
    "test:preload": "node scripts/verify-electron-preload.cjs",
    "test:framer": "node --experimental-strip-types scripts/verify-ndjson-framer.mjs",
    "test:bridge": "node --experimental-strip-types scripts/verify-omp-bridge.mjs",
    "test:tool-events": "node --experimental-strip-types scripts/verify-tool-events.mjs",
    "test:extension-ui": "node --experimental-strip-types scripts/verify-extension-ui.mjs",
    "test:notifications": "node --experimental-strip-types scripts/verify-notifications.mjs",
    "test:observability": "node --experimental-strip-types scripts/verify-observability.mjs",
    "test:session-control": "node --experimental-strip-types scripts/verify-session-control.mjs",
    "test:engine-control": "node --experimental-strip-types scripts/verify-engine-control.mjs",
    "test:composer-attach": "node --experimental-strip-types scripts/verify-composer-attach.mjs",
    "test:markdown": "node scripts/verify-markdown-renderer.mjs",
    "test:tool-events-live": "node --experimental-strip-types scripts/verify-tool-events-live.mjs",
    "test:extension-ui-live": "node --experimental-strip-types scripts/verify-extension-ui-live.mjs",
    "test:sessions-live": "node --experimental-strip-types scripts/verify-sessions-live.mjs",
    "test:handshake": "node --experimental-strip-types scripts/verify-rpc-handshake.mjs",
    "test:stream": "node --experimental-strip-types scripts/verify-stream-translation.mjs",
    "test:model-state": "node --experimental-strip-types scripts/verify-model-state-ipc.mjs",
    "test:sessions": "node --experimental-strip-types scripts/verify-sessions.mjs",
    "test:subagent-hub": "node --experimental-strip-types scripts/verify-subagent-hub.mjs",
    "test:renderer-chat": "node --experimental-strip-types scripts/verify-renderer-live-chat.mjs",
    "test:renderer-tool-diff": "node --experimental-strip-types scripts/verify-renderer-tool-diff.mjs",
    "test:renderer-ui-request": "node --experimental-strip-types scripts/verify-renderer-ui-request.mjs",
    "test:renderer-sessions": "node --experimental-strip-types scripts/verify-renderer-sessions.mjs"
  },
  "keywords": [
    "omp",
    "oh-my-pi",
    "coding-agent",
    "antigravity",
    "codex",
    "electron",
    "mac-app"
  ],
  "author": "OMP Team",
  "license": "MIT",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.11",
    "monaco-editor": "^0.52.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
